{
  "name": "dsh-remote",
  "version": "0.1.0",
  "description": "Authenticated outbound relay for the DeepSeek Harness web interface",
  "type": "module",
  "license": "MIT",
  "main": "src/node.js",
  "exports": {
    ".": "./src/node.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "relay": "node relay/server.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  }
}
